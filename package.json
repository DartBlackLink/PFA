{
  "name": "ecologistica-web-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Pruebas E2E de EcoLogística Huancayo; no contiene credenciales operativas",
  "engines": { "node": ">=22" },
  "scripts": {
    "test:e2e": "playwright test",
